meta {
  name: Create curated memory
  type: http
  seq: 20
}

post {
  url: {{baseUrl}}/memories
  body: json
  auth: none
}

headers {
  content-type: application/json
  cookie: {{sessionCookie}}
}

body:json {
  {
    "content": "Customer prefers concise responses.",
    "namespace": "assistant",
    "expiresAt": "2027-01-01T00:00:00.000Z"
  }
}

assert {
  res.status: eq 201
  res.body.id: isString
}
