meta {
  name: Run assistant
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/run
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "input": "Explain why Bun is useful for TypeScript APIs."
  }
}

assert {
  res.status: eq 200
  res.body.runId: isString
  res.body.sessionId: isString
}
