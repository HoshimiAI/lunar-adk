# Copy to the deployment platform's secret/config store; do not commit a real .env.
NODE_ENV=production
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
PORT=3000
LUNAR_ALLOW_UNAUTHENTICATED=false

# Use a durable remote store for multi-instance deployments.
STORAGE_PROVIDER=postgres
DATABASE_URL=

# Use a shared RateLimitStore in application code for more than one instance.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
RATE_LIMIT_TENANT_QUOTAS={}

# Export redacted telemetry to an OTLP collector. Keep content capture disabled.
LUNAR_TELEMETRY=console
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=lunar-elysia
LUNAR_TELEMETRY_CAPTURE_CONTENT=false
