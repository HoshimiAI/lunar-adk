{
  "name": "lunar-adk",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "typecheck": "tsc --build",
    "test": "bun test",
    "test:ci": "RUN_LIVE_TESTS=0 bun test",
    "test:live": "RUN_LIVE_TESTS=1 bun test",
    "audit": "bun audit",
    "ci": "bun run typecheck && bun run test:ci && bun run audit",
    "release:check": "bun scripts/release-check.ts"
  },
  "devDependencies": {
    "@types/bun": "1.4.0",
    "typescript": "5.9.3"
  }
}
